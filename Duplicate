import java.util.Scanner;

public class Duplicate {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int[] dup = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();

        }

        for (int i = 0; i < n; i++) {
            if (dup[i] != 1) {

                for (int j = i + 1; j < n; j++) {
                    if (arr[i] == arr[j]) {
                        dup[i] = 2;
                        dup[j] = 1;

                    }
                }
            }

        }
        for (int i = 0; i < n; i++) {
            if (dup[i] == 2) {
                System.out.println(arr[i]);
            }
        }

    }
}
